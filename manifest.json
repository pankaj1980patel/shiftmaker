{
    "manifest_version": 3,
    "name": "ShiftMate",
    "version": "1.3.3",
    "description": "Keka attendance companion: punch in/out, breaks, auto clock-in/out that skips days off, OTP sign-in, leave & birthday reminders.",
    "permissions": [
        "storage",
        "alarms",
        "notifications",
        "scripting",
        "cookies",
        "geolocation",
        "offscreen"
    ],
    "host_permissions": [
        "https://*.keka.com/*"
    ],
    "background": {
        "service_worker": "src/background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "src/popup.html",
        "default_title": "ShiftMate — attendance, breaks & progress",
        "default_icon": {
            "16": "src/icons/pumpkin-toolbar-16.png",
            "32": "src/icons/pumpkin-toolbar-32.png",
            "48": "src/icons/pumpkin-toolbar-48.png",
            "128": "src/icons/pumpkin-toolbar-128.png"
        }
    },
    "icons": {
        "16": "src/icons/smily-pumpkin-16.png",
        "32": "src/icons/smily-pumpkin-32.png",
        "48": "src/icons/smily-pumpkin-48.png",
        "128": "src/icons/smily-pumpkin-128.png"
    }
}